# Copy to .env or set in the shell. All keys use the GPDEDUPE_ prefix.

# Windows Yoga (keep OUT of OneDrive):
# GPDEDUPE_DATA_ROOT=C:\gpdedupe

# macOS / Linux:
# GPDEDUPE_DATA_ROOT=/Users/you/.gpdedupe

# GPDEDUPE_PORT=8787
# GPDEDUPE_FETCH_CONCURRENCY=16
# GPDEDUPE_EMBED_BATCH_SIZE=32
# GPDEDUPE_TIME_WINDOW_S=30
# GPDEDUPE_TIME_COSINE_THRESHOLD=0.92
# GPDEDUPE_GLOBAL_COSINE_THRESHOLD=0.97
